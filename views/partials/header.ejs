<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Task Management App' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navigation -->
    <% if (user) { %>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <% if (user.account_type === 'Admin') { %>
                    <a class="navbar-brand">
                        <i class="fas fa-tasks"></i> Administrator
                    </a>
                <% } else { %>
                    <a class="navbar-brand">
                        <i class="fas fa-tasks"></i> Task Manager
                    </a>
                <% } %>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="tasksDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-list-check"></i> Tasks
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="tasksDropdown">
                                <li><a class="dropdown-item" href="/tasks"><i class="fas fa-list"></i> All Tasks</a></li>
                                <li>
                                    <% if (!user.is_banned) { %>
                                        <a class="dropdown-item" href="/tasks/create"><i class="fas fa-plus"></i> Create Task</a>
                                    <% } %>
                                </li>
                            </ul>
                        </li>
                        <% if (user.account_type === 'Admin') { %>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-list-check"></i> Profile
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="profileDropdown">
                                    <li>
                                        <a class="dropdown-item" href="/profile"><i class="fas fa-user"></i> My Profile</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/users/admin"><i class="fas fa-users-cog"></i> User Management</a>
                                    </li>
                                </ul>

                            </li>
                        <% } else{ %>
                            <li class="nav-item">
                                <a class="nav-link" href="/profile">
                                    <i class="fas fa-user"></i> My Profile
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </nav>
    <% } %>

    <!-- Banned User Notification -->
    <% if (user && user.is_banned) { %>
        <div class="alert alert-danger text-center mb-0 rounded-0">
            <i class="fas fa-ban"></i> Your account has been banned. You cannot create, edit, or delete tasks.
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (success_msg) { %>
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <%= success_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    
    <% if (error_msg) { %>
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="container mt-4">