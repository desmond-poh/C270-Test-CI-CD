<%- include('../partials/header', { title: 'Register' }) -%>

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
    }
    body {
        background-image: url('/img/bg2.jpeg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        display: flex;
        flex-direction: column;
    }

    /* Compact card spacing to reduce height */
    .card {
        border-radius: 14px;
    }

    .card-header {
        padding: 0.4rem 0.85rem;
    }

    .card-header h4 {
        font-size: 1.15rem;
    }

    .card-body {
        padding: 0.65rem 0.85rem;
    }

    .mb-3 {
        margin-bottom: 0.65rem !important;
    }

    .form-label {
        font-size: 0.95rem;
        margin-bottom: 0.35rem;
    }

    .form-control {
        font-size: 0.9rem;
        padding: 0.3rem 0.6rem;
    }

    .form-text {
        font-size: 0.8rem;
    }

    .d-grid.gap-2 {
        gap: 0.3rem !important;
        margin-top: 0.4rem !important;
    }

    .btn {
        padding: 0.35rem 0.6rem;
        font-size: 0.95rem;
    }

    .mt-3 {
        margin-top: 0.35rem !important;
    }

    .mt-3 small {
        font-size: 0.75rem;
    }

    .container-wrapper {
        padding-top: 2rem;
    }
</style>

<div class="row justify-content-center align-items-start min-vh-100 container-wrapper">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-user-plus"></i> Create Account</h4>
            </div>
            <div class="card-body">
                <form action="/register" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="username" class="form-label">
                            <i class="fas fa-user"></i> Username *
                        </label>
                        <input type="text" 
                               class="form-control" 
                               id="username" 
                               name="username" 
                               required
                               placeholder="Choose a username">
                    </div>
                    
                    <div class="mb-3">
                        <label for="email" class="form-label">
                            <i class="fas fa-envelope"></i> Email *
                        </label>
                        <input type="email" 
                               class="form-control" 
                               id="email" 
                               name="email" 
                               required
                               placeholder="your@email.com">
                    </div>
                    
                    <div class="mb-3">
                        <label for="contact_number" class="form-label">
                            <i class="fas fa-phone"></i> Contact Number (Optional)
                        </label>
                        <input type="tel" 
                               class="form-control" 
                               id="contact_number" 
                               name="contact_number"
                               placeholder="+1 234 567 8900">
                    </div>
                    
                    <div class="mb-3">
                        <label for="profile_picture" class="form-label">
                            <i class="fas fa-image"></i> Profile Picture (Optional)
                        </label>
                        <input type="file" 
                               class="form-control" 
                               id="profile_picture" 
                               name="profile_picture"
                               accept="image/jpeg,image/jpg,image/png,image/gif">
                        <div class="form-text">JPG, PNG, or GIF (Max 5MB)</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock"></i> Password *
                        </label>
                        <input type="password" 
                               class="form-control" 
                               id="password" 
                               name="password" 
                               required
                               placeholder="Minimum 6 characters">
                        <div class="form-text">Must be at least 6 characters</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="confirm_password" class="form-label">
                            <i class="fas fa-lock"></i> Confirm Password *
                        </label>
                        <input type="password" 
                               class="form-control" 
                               id="confirm_password" 
                               name="confirm_password" 
                               required
                               placeholder="Re-enter your password">
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus"></i> Create Account
                        </button>
                        <a href="/" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-in-alt"></i> Go Back
                        </a>
                    </div>
                    
                    <div class="mt-3 text-muted">
                        <small>* Required fields</small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') -%>