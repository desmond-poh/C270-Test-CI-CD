<%- include('../partials/header', { title: 'Task Details' }) -%>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-tasks"></i> Task Details</h4>
                    <div>
                        <% if (isOwner && !user.is_banned) { %>
                            <a href="/tasks/edit/<%= task.id %>" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a href="/tasks/delete/<%= task.id %>" 
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this task?')">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="border-bottom pb-2"><%= task.title %></h3>
                    
                    <% if (task.description) { %>
                        <div class="mb-3">
                            <h5><i class="fas fa-align-left"></i> Description:</h5>
                            <p class="lead"><%= task.description %></p>
                        </div>
                    <% } %>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <h6><i class="fas fa-user"></i> Created By:</h6>
                                <p><%= task.creator_name %></p>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <h6><i class="fas fa-eye"></i> Visibility:</h6>
                                <% if (task.visibility === 'personal') { %>
                                    <span class="badge bg-warning">
                                        <i class="fas fa-user"></i> Personal
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-success">
                                        <i class="fas fa-users"></i> For All
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <h6><i class="fas fa-calendar-plus"></i> Created:</h6>
                                <p><%= new Date(task.created_at).toLocaleString() %></p>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <h6><i class="fas fa-calendar-check"></i> Last Updated:</h6>
                                <p><%= new Date(task.updated_at).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="d-grid gap-2">
                    <a href="/tasks" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Tasks
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') -%>